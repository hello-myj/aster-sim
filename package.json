    "check-sdk": "node scripts/check-sdk.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "bmp-js": "0.1.0",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "ws": "8.18.3"
  }
}
